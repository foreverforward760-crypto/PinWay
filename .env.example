# ════════════════════════════════════════════════════════════════════════
#  PinWay — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env to source control.
# ════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Your deployed frontend URL (Railway auto-sets this; also used for CORS)
FRONTEND_URL=https://yourdomain.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────────────────────────
#
# Option A — Railway (recommended):
#   Add a Postgres plugin in Railway and DATABASE_URL is auto-injected. Done.
#
DATABASE_URL=
PGSSL=true   # Set to false for local dev without SSL
#
# Option B — Local / manual:
#   Leave DATABASE_URL blank and fill in individual vars below.
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinway
DB_USER=pinway_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Card Issuing ─────────────────────────────────────────────────────────────
#
# Option A — Real Stripe Issuing (test mode is free):
#   1. stripe.com → enable Issuing → create a test cardholder
#   2. Use sk_test_... key (NOT sk_live_...)
#
STRIPE_SECRET_KEY=
STRIPE_TEST_CARDHOLDER_ID=
#
# Option B — Demo mode (synthetic Luhn-valid cards, full flow, no Stripe needed):
#   Safe for sales demos. Set to false before going live.
#
DEMO_MODE=true

# ─── Twilio (SMS delivery) ────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── SendGrid (Email delivery) ────────────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=PinWay

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
